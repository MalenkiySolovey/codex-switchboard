<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexSwitcher.App.Views.AccountsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodexSwitcher.App.ViewModels"
    xmlns:conv="using:CodexSwitcher.App.Support"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:BadgeToTextConverter x:Key="BadgeText" />
        <conv:BadgeToBrushConverter x:Key="BadgeBrush" />
        <conv:ActiveToBackgroundConverter x:Key="ActiveBg" />
        <conv:CardBorderBrushConverter x:Key="CardBorder" />
        <conv:QuotaProgressBrushConverter x:Key="QuotaBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:BoolToChevronConverter x:Key="BoolToChevron" />
        <conv:BoolToCopyGlyphConverter x:Key="BoolToCopyGlyph" />
        <conv:IntToVisibilityConverter x:Key="IntToVis" />
        <conv:ApiCardBorderBrushConverter x:Key="ApiCardBorder" />
        <conv:ApiCardBackgroundConverter x:Key="ApiCardBg" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="16,0"
                        VerticalAlignment="Center">
                <Image x:Name="AppIcon" Width="22" Height="22" />
                <TextBlock Text="Codex Switchboard" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Header + toolbar -->
        <Grid Grid.Row="1" Margin="24,12,24,8" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Loc.AccountsHeader}" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{x:Bind Loc.AccountsSubtitle}" Opacity="0.7" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.RefreshAllCommand}"
                        ToolTipService.ToolTip="{x:Bind Loc.RefreshAllTooltip}"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.RefreshAll}" />
                    </StackPanel>
                </Button>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{x:Bind Loc.SearchPlaceholder}" Width="200" QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}" />
                <Button Command="{x:Bind ViewModel.DetectAccountCommand}"
                        ToolTipService.ToolTip="{x:Bind Loc.DetectAccountTooltip}"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.DetectAccount}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ImportAccountsCommand}"
                        ToolTipService.ToolTip="{x:Bind Loc.ImportAccountsTooltip}"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.ImportAccounts}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ExportAllCommand}"
                        ToolTipService.ToolTip="{x:Bind Loc.ExportAllTooltip}"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.ExportAll}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.AddAccountCommand}"
                        Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.SignInOAuth}" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenBrowserClick" ToolTipService.ToolTip="{x:Bind Loc.BrowserTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock Text="{x:Bind Loc.BrowserButton}" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpen2FaClick" ToolTipService.ToolTip="{x:Bind Loc.TwoFactorTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.TwoFactorButton}" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenSettingsClick" ToolTipService.ToolTip="{x:Bind Loc.SettingsButtonTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.SettingsButton}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- InfoBar -->
        <InfoBar Grid.Row="2" Margin="24,4"
                 IsOpen="{x:Bind ViewModel.InfoOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" />

        <!-- Content -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Active Target Status Banner -->
            <Border Grid.Row="0" Margin="24,0,24,8"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                        <TextBlock Text="{x:Bind Loc.ActiveRoutingTitle}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text=":" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTargetSummary, Mode=OneWay}" FontWeight="Medium" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                        <FontIcon Glyph="&#xE77B;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Loc.CredentialSlotTitle}" Opacity="0.7" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text=":" Opacity="0.7" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTargetCredentialSlot, Mode=OneWay}" Opacity="0.9" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Click="OnSelectChatGptTabClick"
                            Visibility="{x:Bind ViewModel.IsRoutingActiveToApi, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            FontSize="11"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="11" />
                            <TextBlock Text="{x:Bind Loc.SwitchToChatGpt}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Segmented Navigation: ChatGPT Accounts vs API Providers -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="24,0,24,12">
                <Button Click="OnSelectChatGptTabClick" Padding="14,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.ChatGPTAccountsTab}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Click="OnSelectApiProvidersTabClick" Padding="14,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.ApiProvidersTab}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Tab Contents Container -->
            <Grid Grid.Row="2">
                <!-- Tab 0: ChatGPT Accounts -->
                <Grid Visibility="{x:Bind ViewModel.SelectedTab, Mode=OneWay, Converter={StaticResource IntToVis}, ConverterParameter=0}">

                    <!-- Empty state with detected active account -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowDetectedAccountEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center"
                        Background="{ThemeResource BrandGradientBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="34" Foreground="{ThemeResource BrandOnAccentBrush}" />
                </Border>
                <TextBlock Text="{x:Bind Loc.DetectedAccountTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.DetectedActiveAccountDetails, Mode=OneWay}"
                           FontSize="15" FontWeight="Medium" Opacity="0.9" HorizontalAlignment="Center" />
                <TextBlock TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Text="{x:Bind Loc.DetectedAccountBody}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.AdoptActiveCommand}"
                            Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.ImportCurrent}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.AddAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.SignInOAuth}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ImportAccountsCommand}" Content="{x:Bind Loc.ImportAccounts}" />
                </StackPanel>
            </StackPanel>

            <!-- Standard Empty state (no active account detected) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowNormalEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center"
                        Background="{ThemeResource BrandGradientBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="34" Foreground="{ThemeResource BrandOnAccentBrush}" />
                </Border>
                <TextBlock Text="{x:Bind Loc.EmptyTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Text="{x:Bind Loc.EmptyBody}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.AddAccountCommand}"
                            Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.SignInOAuth}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.AdoptActiveCommand}" Content="{x:Bind Loc.ImportCurrent}" />
                    <Button Command="{x:Bind ViewModel.ImportAccountsCommand}" Content="{x:Bind Loc.ImportAccounts}" />
                </StackPanel>
            </StackPanel>

            <!-- Account list -->
            <Grid Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}"
                  RowDefinitions="Auto,*">

                <InfoBar Grid.Row="0" Margin="24,0,24,8" IsOpen="{x:Bind ViewModel.ShowAdoptPrompt, Mode=OneWay}"
                         IsClosable="False" Severity="Informational"
                         Title="{x:Bind Loc.AdoptTitle}"
                         Message="{x:Bind Loc.AdoptMessage}">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind Loc.Import}" Command="{x:Bind ViewModel.AdoptActiveCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Accounts}"
                          SelectionMode="None" Padding="24,0,24,24"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                          DragItemsCompleted="OnAccountsReordered">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountItemViewModel">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1.5" Padding="16,10"
                                    BorderBrush="{x:Bind Converter={StaticResource CardBorder}}"
                                    Background="{x:Bind Converter={StaticResource ActiveBg}}">
                                <StackPanel Spacing="10">
                                    <!-- Top Row: Identity + Badges + Compact Quota + 2FA + Actions + Expand/Collapse -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                        <!-- Col 0: Avatar -->
                                        <Border Grid.Column="0" Width="44" Height="44"
                                                CornerRadius="{StaticResource AvatarCornerRadius}"
                                                Background="{ThemeResource BrandGradientBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Initials}" FontWeight="Bold" FontSize="16"
                                                       Foreground="{ThemeResource BrandOnAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Col 1: Name, Email/Plan, Badges -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="16"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                           ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                           VerticalAlignment="Center" />
                                                <!-- Health status badge -->
                                                <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                        BorderBrush="{x:Bind Badge, Converter={StaticResource BadgeBrush}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                                               Text="{x:Bind Badge, Converter={StaticResource BadgeText}}"
                                                               Foreground="{x:Bind Badge, Converter={StaticResource BadgeBrush}}" />
                                                </Border>
                                                <!-- Stale Cache Badge -->
                                                <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                        BorderBrush="{ThemeResource HealthWarnBrush}"
                                                        Visibility="{x:Bind Usage.ShowStaleBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                                               Text="{x:Bind Usage.StaleBadgeLabel, Mode=OneWay}"
                                                               Foreground="{ThemeResource HealthWarnBrush}" />
                                                </Border>
                                                <!-- Rate Limited Badge -->
                                                <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                        BorderBrush="{ThemeResource HealthDangerBrush}"
                                                        Visibility="{x:Bind Usage.ShowRateLimitedBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                                               Text="{x:Bind Usage.RateLimitedBadgeLabel, Mode=OneWay}"
                                                               Foreground="{ThemeResource HealthDangerBrush}" />
                                                </Border>
                                                <!-- Refreshing Badge -->
                                                <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                        BorderBrush="{ThemeResource BrandAccentBrush}"
                                                        Visibility="{x:Bind Usage.ShowRefreshingBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                                               Text="{x:Bind Usage.RefreshingBadgeLabel, Mode=OneWay}"
                                                               Foreground="{ThemeResource BrandAccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7" FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                           ToolTipService.ToolTip="{x:Bind Subtitle}" />
                                                <TextBlock Text="·" Opacity="0.4" FontSize="13" VerticalAlignment="Center"
                                                           Visibility="{x:Bind HasPlanOrSubscription, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{x:Bind PlanText}" Opacity="0.55" FontSize="13" VerticalAlignment="Center"
                                                           Visibility="{x:Bind PlanText, Converter={StaticResource StringToVis}}" />
                                                <TextBlock Text="·" Opacity="0.4" FontSize="13" VerticalAlignment="Center"
                                                           Visibility="{x:Bind ShowSubscriptionSeparator, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{x:Bind SubscriptionDisplayText}" Opacity="0.55" FontSize="13" VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{x:Bind SubscriptionTooltipText}"
                                                           Visibility="{x:Bind HasSubscriptionText, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 2: Compact Quota Summary (visible when IsCompact) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="110"
                                                    Visibility="{x:Bind IsCompact, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <!-- When quota windows are available -->
                                            <StackPanel Visibility="{x:Bind Usage.HasWindows, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="2">
                                                <ItemsControl ItemsSource="{x:Bind Usage.CompactWindows, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:UsageWindowViewModel">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="{x:Bind CompactTooltipText, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind DisplayLabel}" FontWeight="SemiBold" FontSize="11" Opacity="0.9" />
                                                                <TextBlock Text="{x:Bind CompactRemainingText, Mode=OneWay}" FontWeight="SemiBold" FontSize="11"
                                                                           Foreground="{x:Bind Converter={StaticResource QuotaBrush}, Mode=OneWay}" />
                                                                <TextBlock Text="·" FontSize="10" Opacity="0.4" />
                                                                <TextBlock Text="{x:Bind CompactResetText, Mode=OneWay}" FontSize="11" Opacity="0.75" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- +N additional windows badge if >2 windows -->
                                                <Border CornerRadius="3" Padding="5,1" Background="{ThemeResource LayerFillColorAltBrush}"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="{x:Bind Usage.AdditionalWindowsTooltip, Mode=OneWay}"
                                                        Visibility="{x:Bind Usage.HasAdditionalWindows, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Bind Usage.AdditionalWindowsBadge, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Opacity="0.7" />
                                                </Border>
                                            </StackPanel>

                                            <!-- When no quota windows: truthful status summary -->
                                            <TextBlock Text="{x:Bind Usage.CompactStatusText, Mode=OneWay}" FontSize="11" Opacity="0.6"
                                                       Visibility="{x:Bind Usage.HasWindows, Mode=OneWay, Converter={StaticResource InvBoolToVis}}" />
                                        </StackPanel>

                                        <!-- Col 3: Compact Reset Credits (visible when IsCompact && HasResetCredits) -->
                                        <Button Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}" Padding="6,2"
                                                Visibility="{x:Bind ShowCompactResetCredits, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                ToolTipService.ToolTip="{x:Bind Usage.ResetCreditsHeader, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xEC05;" FontSize="11" Foreground="{ThemeResource BrandAccentBrush}" />
                                                <TextBlock Text="{x:Bind Usage.CompactResetCreditsText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.5" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Spacing="8" MinWidth="240" MaxWidth="340">
                                                        <TextBlock Text="{x:Bind Usage.ResetCreditsHeader, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                                        <ItemsControl ItemsSource="{x:Bind Usage.DetailedCredits, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ResetCreditItemViewModel">
                                                                    <Grid Margin="0,3">
                                                                        <StackPanel Spacing="2">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                <Border Width="7" Height="7" CornerRadius="3.5" Background="{x:Bind UrgencyBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="11" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{x:Bind ExpiryText}" FontSize="10" Opacity="0.7" Margin="13,0,0,0" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{x:Bind Usage.UnreportedCreditsText, Mode=OneWay}"
                                                                   Visibility="{x:Bind Usage.HasUnreportedCredits, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="10" Opacity="0.6" FontStyle="Italic" />
                                                        <TextBlock Text="{x:Bind Usage.NoDetailedCreditsMessage, Mode=OneWay}"
                                                                   Visibility="{x:Bind Usage.HasDetailedCredits, Mode=OneWay, Converter={StaticResource InvBoolToVis}}"
                                                                   FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <!-- Col 4: Profile 2FA Inline Indicator (visible when HasTotpConfigured) -->
                                        <Border Grid.Column="4" VerticalAlignment="Center" Padding="6,3"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Visibility="{x:Bind HasTotpConfigured, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- Hidden state -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsTotpRevealed, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                                                    <FontIcon Glyph="&#xE72E;" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                                    <TextBlock Text="2FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" />
                                                    <TextBlock Text="••••••" FontSize="11" FontFamily="Consolas, Cascadia Mono, monospace" Opacity="0.5" VerticalAlignment="Center" Margin="2,0" />
                                                    <Button Click="OnRevealTotpClick"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Padding="4,2" MinWidth="0" MinHeight="0"
                                                            ToolTipService.ToolTip="{x:Bind TotpRevealTooltip, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind TotpRevealButtonAutomationName, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE7B3;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Revealed state -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsTotpRevealed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <FontIcon Glyph="&#xEA18;" FontSize="11" Foreground="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="2FA" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind TotpCodeText, Mode=OneWay}" FontSize="12" FontWeight="Bold"
                                                               FontFamily="Consolas, Cascadia Mono, monospace" VerticalAlignment="Center" Margin="2,0" />
                                                    <TextBlock Text="·" FontSize="10" Opacity="0.4" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind TotpCountdownText, Mode=OneWay}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                                                    <Button Click="OnCopyTotpClick"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Padding="4,2" MinWidth="0" MinHeight="0"
                                                            ToolTipService.ToolTip="{x:Bind TotpCopyTooltip, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind TotpCopyButtonAutomationName, Mode=OneWay}">
                                                        <FontIcon Glyph="{x:Bind IsTotpCopied, Mode=OneWay, Converter={StaticResource BoolToCopyGlyph}}" FontSize="11" />
                                                    </Button>
                                                    <Button Click="OnHideTotpClick"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Padding="4,2" MinWidth="0" MinHeight="0"
                                                            ToolTipService.ToolTip="{x:Bind TotpHideTooltip, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind TotpRevealButtonAutomationName, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xED1A;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Col 5: Per-card manual refresh button -->
                                        <Button Grid.Column="5" VerticalAlignment="Center" Click="OnRefreshAccountClick"
                                                ToolTipService.ToolTip="{x:Bind Usage.RefreshUsageTooltip, Mode=OneWay}"
                                                Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        </Button>

                                        <!-- Col 6: Switch / In Use -->
                                        <Button Grid.Column="6" VerticalAlignment="Center" Click="OnSwitchClick"
                                                Visibility="{x:Bind CanSwitch, Converter={StaticResource BoolToVis}}"
                                                Background="{ThemeResource BrandAccentBrush}"
                                                Foreground="{ThemeResource BrandOnAccentBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                                <TextBlock Text="{x:Bind SwitchLabel}" />
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="6" VerticalAlignment="Center" Padding="10,6"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Visibility="{x:Bind IsInUse, Converter={StaticResource BoolToVis}}"
                                                Background="{ThemeResource BrandAccentSoftBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource BrandAccentBrush}" />
                                                <TextBlock Text="{x:Bind InUseLabel}" Foreground="{ThemeResource BrandAccentBrush}"
                                                           FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Col 7: More Actions Flyout -->
                                        <Button Grid.Column="7" VerticalAlignment="Center" Background="Transparent"
                                                BorderThickness="0" ToolTipService.ToolTip="{x:Bind MoreActionsLabel}">
                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="{x:Bind ExportLabel}" Click="OnExportItemClick">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{x:Bind RenameLabel}" Click="OnRenameItemClick">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{x:Bind SubscriptionTrackingLabel}" Click="OnSubscriptionTrackingClick">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC05;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{x:Bind MarkUsedLabel}" Click="OnMarkUsedClick"
                                                                    Visibility="{x:Bind IsMarkedUsed, Converter={StaticResource InvBoolToVis}}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{x:Bind UnmarkUsedLabel}" Click="OnUnmarkUsedClick"
                                                                    Visibility="{x:Bind IsMarkedUsed, Converter={StaticResource BoolToVis}}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{x:Bind MarkReLoginLabel}" Click="OnMarkReLoginClick">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BA;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{x:Bind TotpMenuLabel, Mode=OneWay}" Click="OnAddOrManageTotpClick">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{x:Bind RemoveLabel}" Click="OnRemoveItemClick">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                        <!-- Col 8: Collapse / Expand Button -->
                                        <Button Grid.Column="8" VerticalAlignment="Center" Background="Transparent"
                                                BorderThickness="0" Padding="8" Click="OnToggleCollapseClick"
                                                ToolTipService.ToolTip="{x:Bind ExpandCollapseTooltip, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind ExpandCollapseAutomationName, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToChevron}}" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- Expanded Details Section -->
                                    <StackPanel Spacing="10" Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <!-- Notice Banner Row (When notice exists: AuthRequired, ProcessDown, CredentialConflict) -->
                                        <Border Padding="10,6" CornerRadius="{StaticResource ControlCornerRadius}"
                                                Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="1" BorderBrush="{ThemeResource HealthWarnBrush}"
                                                Visibility="{x:Bind Usage.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource HealthWarnBrush}" />
                                                <TextBlock Text="{x:Bind Usage.NoticeMessage, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Opacity="0.9" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Quota Windows Section -->
                                        <ItemsControl ItemsSource="{x:Bind Usage.Windows, Mode=OneWay}"
                                                      Visibility="{x:Bind Usage.HasWindows, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:UsageWindowViewModel">
                                                    <StackPanel Spacing="3" Margin="0,2,0,6">
                                                        <!-- Window Header: DisplayLabel + Limit Reached Badge on Left, Remaining % on Right -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayLabel}" FontWeight="SemiBold" FontSize="12" />
                                                                <Border CornerRadius="3" Padding="5,1" Background="{ThemeResource HealthDangerBrush}"
                                                                        Visibility="{x:Bind IsExhausted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{x:Bind LimitReachedLabel}" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{ThemeResource BrandOnAccentBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind RemainingText, Mode=OneWay}"
                                                                       FontWeight="SemiBold" FontSize="12" />
                                                        </Grid>

                                                        <!-- Progress Bar (Value = RemainingPercent, matching text) -->
                                                        <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" Minimum="0"
                                                                     Height="5" CornerRadius="2.5"
                                                                     Foreground="{x:Bind Converter={StaticResource QuotaBrush}, Mode=OneWay}" />

                                                        <!-- Window Footer: Used % on Left, Relative Reset Countdown on Right -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{x:Bind UsedText, Mode=OneWay}" Opacity="0.6" FontSize="11" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ResetCountdownText, Mode=OneWay}"
                                                                       ToolTipService.ToolTip="{x:Bind ResetTooltipText, Mode=OneWay}"
                                                                       Opacity="0.75" FontSize="11" />
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Never Loaded Prompt (if no usage data has been queried yet) -->
                                        <TextBlock Text="{x:Bind Usage.NeverLoadedLabel, Mode=OneWay}"
                                                   Visibility="{x:Bind Usage.ShowNeverLoadedText, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                   Opacity="0.5" FontSize="12" Margin="0,2,0,2" />

                                        <!-- Account Activity Section (Collapsible / Compact) -->
                                        <Border CornerRadius="{StaticResource ControlCornerRadius}"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                Padding="8,6" Margin="0,2,0,4"
                                                Visibility="{x:Bind Usage.ShowActivitySection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Spacing="4">
                                                <!-- Status Notice Banner (Unsupported runtime, temporary unavailable, or cached notice) -->
                                                <Border CornerRadius="4" Padding="8,4" Margin="2,2,2,2"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource HealthWarnBrush}" BorderThickness="1"
                                                        Visibility="{x:Bind Usage.Activity.HasStatusNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource HealthWarnBrush}" />
                                                        <TextBlock Text="{x:Bind Usage.Activity.StatusNotice, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Collapsible Activity Data Content -->
                                                <StackPanel Visibility="{x:Bind Usage.Activity.HasActivity, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="4">
                                                    <!-- Toggle Button Header -->
                                                    <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Padding="4,2"
                                                            Command="{x:Bind Usage.Activity.ToggleExpandCommand, Mode=OneWay}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource BrandAccentBrush}" />
                                                                <TextBlock Text="{x:Bind Usage.Activity.ActivitySectionTitle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Opacity="0.8" />
                                                            </StackPanel>
                                                            <FontIcon Grid.Column="2" Glyph="{x:Bind Usage.Activity.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToChevron}}"
                                                                      FontSize="10" Opacity="0.5" />
                                                        </Grid>
                                                    </Button>

                                                    <!-- Collapsed Preview (single line: Lifetime & Streak) -->
                                                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,0"
                                                          Visibility="{x:Bind Usage.Activity.IsExpanded, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{x:Bind Usage.Activity.LifetimeTokens, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Text="tokens" FontSize="11" Opacity="0.5" />
                                                            <TextBlock Text="·" FontSize="11" Opacity="0.4" Margin="2,0" />
                                                            <TextBlock Text="Peak" FontSize="11" Opacity="0.5" />
                                                            <TextBlock Text="{x:Bind Usage.Activity.PeakDailyTokens, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Usage.Activity.CurrentStreak, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                                    </Grid>

                                                    <!-- Expanded Activity Details -->
                                                    <StackPanel Visibility="{x:Bind Usage.Activity.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="6" Margin="4,2,4,2">
                                                        <!-- Metric Tiles Grid -->
                                                        <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,2">
                                                            <StackPanel Grid.Column="0" Spacing="1" ToolTipService.ToolTip="{x:Bind Usage.Activity.LifetimeTokensTooltip, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind Usage.Activity.LifetimeLabel, Mode=OneWay}" FontSize="9" Opacity="0.6" />
                                                                <TextBlock Text="{x:Bind Usage.Activity.LifetimeTokens, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="1" ToolTipService.ToolTip="{x:Bind Usage.Activity.PeakDailyTokensTooltip, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind Usage.Activity.PeakDayLabel, Mode=OneWay}" FontSize="9" Opacity="0.6" />
                                                                <TextBlock Text="{x:Bind Usage.Activity.PeakDailyTokens, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="1" ToolTipService.ToolTip="{x:Bind Usage.Activity.LongestTurnTooltip, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind Usage.Activity.LongestTurnLabel, Mode=OneWay}" FontSize="9" Opacity="0.6" />
                                                                <TextBlock Text="{x:Bind Usage.Activity.LongestTurn, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Spacing="1">
                                                                <TextBlock Text="{x:Bind Usage.Activity.CurrentStreakLabel, Mode=OneWay}" FontSize="9" Opacity="0.6" />
                                                                <TextBlock Text="{x:Bind Usage.Activity.CurrentStreak, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Spacing="1">
                                                                <TextBlock Text="{x:Bind Usage.Activity.LongestStreakLabel, Mode=OneWay}" FontSize="9" Opacity="0.6" />
                                                                <TextBlock Text="{x:Bind Usage.Activity.LongestStreak, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Daily Activity Mini Bars -->
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                                            <ItemsControl ItemsSource="{x:Bind Usage.Activity.Bars, Mode=OneWay}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" Height="50" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ActivityBarItemViewModel">
                                                                        <StackPanel Spacing="2" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                            <Border Width="12" Height="{x:Bind BarHeight}" Background="{ThemeResource BrandAccentBrush}"
                                                                                    CornerRadius="2" VerticalAlignment="Bottom" Opacity="0.85" />
                                                                            <TextBlock Text="{x:Bind DisplayDate}" FontSize="8" Opacity="0.5" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                        <!-- Server-reported neutral disclaimer -->
                                                        <TextBlock Text="{x:Bind Usage.Activity.DisclaimerText, Mode=OneWay}" FontSize="10" Opacity="0.4" FontStyle="Italic" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card Footer Row: Health status on Left, Reset credits and Last switched on Right -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Bind HealthText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SubtleButtonStyle}" Padding="4,1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind Usage.HasResetCredits, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xEC05;" FontSize="11" Opacity="0.7" />
                                                        <TextBlock Text="{x:Bind Usage.ResetCreditsText, Mode=OneWay}" FontSize="11" Opacity="0.8" />
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8" Opacity="0.5" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout Placement="Top">
                                                            <StackPanel Spacing="8" MinWidth="240" MaxWidth="340">
                                                                <TextBlock Text="{x:Bind Usage.ResetCreditsHeader, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                                                <ItemsControl ItemsSource="{x:Bind Usage.DetailedCredits, Mode=OneWay}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ResetCreditItemViewModel">
                                                                            <Grid Margin="0,3">
                                                                                <StackPanel Spacing="2">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="{x:Bind UrgencyBrush}" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="11" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{x:Bind ExpiryText}" FontSize="10" Opacity="0.7" Margin="13,0,0,0" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{x:Bind Usage.UnreportedCreditsText, Mode=OneWay}"
                                                                           Visibility="{x:Bind Usage.HasUnreportedCredits, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                           FontSize="10" Opacity="0.6" FontStyle="Italic" />
                                                                <TextBlock Text="{x:Bind Usage.NoDetailedCreditsMessage, Mode=OneWay}"
                                                                           Visibility="{x:Bind Usage.HasDetailedCredits, Mode=OneWay, Converter={StaticResource InvBoolToVis}}"
                                                                           FontSize="11" Opacity="0.6" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <TextBlock Text="{x:Bind LastSwitchedText}" Opacity="0.5" FontSize="11"
                                                           ToolTipService.ToolTip="{x:Bind LastSwitchedTooltip}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Tab 1: API Providers -->
        <Grid Visibility="{x:Bind ViewModel.SelectedTab, Mode=OneWay, Converter={StaticResource IntToVis}, ConverterParameter=1}">
            <!-- API Providers Empty State -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowApiProvidersEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center"
                        Background="{ThemeResource BrandGradientBrush}">
                    <FontIcon Glyph="&#xE72D;" FontSize="34" Foreground="{ThemeResource BrandOnAccentBrush}" />
                </Border>
                <TextBlock Text="{x:Bind Loc.ApiProvidersEmptyTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Text="{x:Bind Loc.ApiProvidersEmptyBody}" />
                <Button Command="{x:Bind ViewModel.AddApiProviderCommand}" HorizontalAlignment="Center"
                        Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{x:Bind Loc.AddApiProvider}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- API Providers List -->
            <Grid Visibility="{x:Bind ViewModel.ShowApiProvidersEmptyState, Mode=OneWay, Converter={StaticResource InvBoolToVis}}"
                  RowDefinitions="Auto,*">
                <!-- Toolbar for API tab -->
                <Grid Grid.Row="0" Margin="24,0,24,12" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Loc.ApiProvidersHeader}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Loc.ApiProvidersSubtitle}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddApiProviderCommand}"
                            Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.AddApiProvider}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- API Provider Cards -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ApiProviders}"
                          SelectionMode="None" Padding="24,0,24,24"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApiProviderItemViewModel">
                            <Border CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1.5" Padding="16,12"
                                    BorderBrush="{x:Bind Converter={StaticResource ApiCardBorder}}"
                                    Background="{x:Bind Converter={StaticResource ApiCardBg}}">
                                <StackPanel Spacing="10">
                                    <!-- Top row: Identity & Actions -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Col 0: Provider Icon -->
                                        <Border Grid.Column="0" Width="44" Height="44"
                                                CornerRadius="{StaticResource AvatarCornerRadius}"
                                                Background="{ThemeResource BrandGradientBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE72D;" FontSize="20" Foreground="{ThemeResource BrandOnAccentBrush}" />
                                        </Border>

                                        <!-- Col 1: Name, Provider ID, Route, Active badges -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="16" />
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <TextBlock Text="{x:Bind CatalogProviderName}" FontSize="11" Opacity="0.8" />
                                                </Border>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <TextBlock Text="{x:Bind SelectedRoute}" FontSize="11" FontWeight="Medium" />
                                                </Border>
                                                <!-- Active Badge -->
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Visibility="{x:Bind IsTargetActive, Converter={StaticResource BoolToVis}}"
                                                        Background="{ThemeResource BrandAccentBrush}">
                                                    <TextBlock Text="Active Routing" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource BrandOnAccentBrush}" />
                                                </Border>
                                                <!-- Key Missing Badge -->
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Visibility="{x:Bind HasSecret, Converter={StaticResource InvBoolToVis}}"
                                                        Background="{ThemeResource HealthDangerBrush}">
                                                    <TextBlock Text="API Key Required" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Monospace Endpoint & Key Preview -->
                                            <StackPanel Orientation="Horizontal" Spacing="10" Opacity="0.75">
                                                <TextBlock Text="{x:Bind BaseUrl}" FontFamily="Consolas" FontSize="12" />
                                                <TextBlock Text="·" FontSize="12" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE72E;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind KeyPreview}" FontFamily="Consolas" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 2: Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Route Selection / Cycling -->
                                            <Button Click="OnToggleRouteClick"
                                                    Visibility="{x:Bind CanToggleRoute, Converter={StaticResource BoolToVis}}"
                                                    ToolTipService.ToolTip="{x:Bind RouteTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind SelectedRoute}" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Continue Chat (cross-provider thread fork) -->
                                            <Button Click="OnContinueOnClick"
                                                    IsEnabled="{x:Bind HasSecret}"
                                                    ToolTipService.ToolTip="{x:Bind ContinueOnTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8BD;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind ContinueOnLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Switch Button -->
                                            <Button Click="OnSwitchApiClick"
                                                    IsEnabled="{x:Bind CanSwitch}"
                                                    Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE898;" FontSize="13" />
                                                    <TextBlock Text="Switch" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- More Options Menu -->
                                            <Button Padding="8,6">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Edit Provider" Click="OnEditApiProviderClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Replace API Key" Click="OnRotateApiKeyClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8D7;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Remove Credential" Click="OnRemoveApiCredentialClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Remove Provider" Click="OnRemoveApiProviderClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Model, Capabilities, Balance & Usage facts -->
                                    <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="Model:" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind SelectedModel}" FontSize="12" FontWeight="Medium" />
                                            </StackPanel>

                                            <!-- Discover models button or model status -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Click="OnDiscoverModelsClick"
                                                        IsEnabled="{x:Bind HasSecret}"
                                                        Padding="6,2" FontSize="11">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE721;" FontSize="11" />
                                                        <TextBlock Text="Discover models" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="{x:Bind ModelsStatusMessage, Mode=OneWay}"
                                                           FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Balance fact -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="Balance:" FontSize="11" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind BalanceSummary}" FontSize="11" FontWeight="Medium" />
                                            </StackPanel>

                                            <!-- Usage fact -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="Usage:" FontSize="11" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind UsageSummary}" FontSize="11" FontWeight="Medium" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>

    <!-- Busy overlay -->
    <Grid Grid.RowSpan="3" Background="#80000000"
          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="{StaticResource CardCornerRadius}" Padding="28"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ProgressRing IsActive="True" Width="28" Height="28" />
                        <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
