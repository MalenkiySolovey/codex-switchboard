    {
      "id": "openrouter",
      "displayName": "OpenRouter",
      "description": "Unified LLM routing interface with key usage and credit query endpoints.",
      "aliases": [
        "openrouter.ai"
      ],
      "match": {
        "exactHosts": [
          "openrouter.ai"
        ]
      },
      "codex": {
        "wireApi": "responses",
        "authStrategy": "bearer",
        "defaultModel": "openrouter/auto"
      },
      "routes": [
        {
          "id": "primary",
          "displayName": "Primary",
          "baseUrl": "https://openrouter.ai/api/v1",
          "isDefault": true,
          "isReserve": false
        }
      ],
      "trustedHosts": [
        "openrouter.ai"
      ],
      "capabilities": {
        "models": {
          "status": "supported",
          "strategy": "openai-models",
          "request": {
            "method": "GET",
            "path": "/models",
            "auth": "bearer"
          }
        },
        "balance": {
          "status": "supported",
          "strategy": "json-http",
          "request": {
            "method": "GET",
            "url": "https://openrouter.ai/api/v1/key",
            "auth": "bearer"
          },
          "response": {
            "used": {
              "pointer": "/data/usage",
              "type": "decimal"
            },
            "limit": {
              "pointer": "/data/limit",
              "type": "decimal"
            },
            "currency": {
              "literal": "USD"
            }
          }
        },
        "usage": {
          "status": "supported",
          "strategy": "json-http",
          "request": {
            "method": "GET",
            "url": "https://openrouter.ai/api/v1/key",
            "auth": "bearer"
          },
          "response": {
            "used": {
              "pointer": "/data/usage",
              "type": "decimal"
            },
            "limit": {
              "pointer": "/data/limit",
              "type": "decimal"
            },
            "currency": {
              "literal": "USD"
            }
          }
        }
      },
      "evidence": [
        {
          "capability": "balance",
