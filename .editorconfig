root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
indent_style = space
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

[src/CodexSwitcher.App/**]
# WinUI 3 XAML data binding requires instance properties on ViewModels
dotnet_diagnostic.CA1822.severity = none
# Internal dialog namespace segment 'Shared'
dotnet_diagnostic.CA1716.severity = none

[tests/**]
# Test method names conventionally contain underscores (MethodName_Scenario_ExpectedResult)
dotnet_diagnostic.CA1707.severity = none
